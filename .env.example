# CareerTrust Environment Configuration Example
# Copy this file to .env and configure the variables accordingly.

# MongoDB Connection String (Required for scan history log dashboard)
# E.g. mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.ql6r86s.mongodb.net/?appName=Cluster0"

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS="http://127.0.0.1:8000,http://localhost:8000"

# Optional trust-score tuning overrides (defaults are built into the app)
TRUST_WEIGHT_BERT=0.40
TRUST_WEIGHT_TEXT=0.20
TRUST_WEIGHT_DOMAIN=0.25
TRUST_WEIGHT_CONTACT=0.15
TRUST_THRESHOLD_LOW=75
TRUST_THRESHOLD_MEDIUM=55
TRUST_THRESHOLD_HIGH=35
